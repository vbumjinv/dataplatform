DROP TABLE IF EXISTS dp.api_stat_list_kosis;

CREATE TABLE dp.api_stat_list_kosis (
    node_id       bigserial PRIMARY KEY,
    p_stat_code   varchar(100),
    stat_code     varchar(100) NOT NULL,
    tree_no       varchar(200),
    stat_name_no  varchar(1000),
    stat_name     varchar(500) NOT NULL,
    cycle         varchar(10),
    srch_yn       char(1) NOT NULL,
    org_name      varchar(200),
    vw_cd         varchar(40),
    stat_id       varchar(40),
    send_de       varchar(20),
    level_no      integer,
    full_path     varchar(2000),
    created_at    timestamp NOT NULL DEFAULT now()
);


WITH RECURSIVE src AS (

    /* 1차 루트 */
    SELECT
        '*'::varchar(100) AS p_stat_code,
        r.vw_cd::varchar(100) AS stat_code,
        r.vw_name::varchar(500) AS stat_name,
        NULL::varchar(10) AS cycle,
        'N'::char(1) AS srch_yn,
        '통계청'::varchar(200) AS org_name,
        r.vw_cd,
        NULL::varchar(40) AS stat_id,
        NULL::varchar(20) AS send_de,
        0::integer AS level_no,
        r.vw_name::varchar(2000) AS full_path,
        now() AS created_at,
        r.root_order
    FROM (
        SELECT 'MT_ZTITLE' AS vw_cd, '국내통계 주제별' AS vw_name, 1 AS root_order
        UNION ALL SELECT 'MT_OTITLE', '국내통계 기관별', 2
        UNION ALL SELECT 'MT_GTITLE01', 'e-지방지표(주제별)', 3
        UNION ALL SELECT 'MT_GTITLE02', 'e-지방지표(지역별)', 4
        UNION ALL SELECT 'MT_CHOSUN_TITLE', '광복이전통계(1908~1943)', 5
        UNION ALL SELECT 'MT_HANKUK_TITLE', '대한민국통계연감', 6
        UNION ALL SELECT 'MT_STOP_TITLE', '작성중지통계', 7
        UNION ALL SELECT 'MT_RTITLE', '국제통계', 8
        UNION ALL SELECT 'MT_BUKHAN', '북한통계', 9
        UNION ALL SELECT 'MT_TM1_TITLE', '대상별통계', 10
        UNION ALL SELECT 'MT_TM2_TITLE', '이슈별통계', 11
        UNION ALL SELECT 'MT_ETITLE', '영문 KOSIS', 12
    ) r

    UNION ALL

    /* category */
    SELECT
        COALESCE(c.parent_id, c.vw_cd)::varchar(100) AS p_stat_code,
        c.category_id::varchar(100) AS stat_code,
        c.category_name::varchar(500) AS stat_name,
        NULL::varchar(10) AS cycle,
        'N'::char(1) AS srch_yn,
        '통계청'::varchar(200) AS org_name,
        c.vw_cd,
        NULL::varchar(40) AS stat_id,
        NULL::varchar(20) AS send_de,
        c.level_no,
        c.full_path::varchar(2000),
        c.created_at,
        NULL::integer AS root_order
    FROM dp.kosis_category c

    UNION ALL

    /* 최종 통계표 */
    SELECT
        COALESCE(t.parent_id, t.vw_cd)::varchar(100) AS p_stat_code,
        t.tbl_id::varchar(100) AS stat_code,
        t.tbl_nm::varchar(500) AS stat_name,
        NULL::varchar(10) AS cycle,
        'Y'::char(1) AS srch_yn,
        '통계청'::varchar(200) AS org_name,
        t.vw_cd,
        t.stat_id,
        t.send_de,
        t.level_no,
        t.full_path::varchar(2000),
        t.created_at,
        NULL::integer AS root_order
    FROM dp.kosis_table_mst t
),
base AS (
    SELECT
        s.*,
        ROW_NUMBER() OVER (
            PARTITION BY s.p_stat_code
            ORDER BY
                CASE
                    WHEN s.p_stat_code = '*' THEN COALESCE(s.root_order, 9999)
                    ELSE 9999
                END,
                s.level_no NULLS FIRST,
                s.stat_name,
                s.stat_code,
                COALESCE(s.full_path, '')
        ) AS sibling_no
    FROM src s
),
tree AS (
    /* 루트 */
    SELECT
        b.p_stat_code,
        b.stat_code,
        b.sibling_no::text AS tree_no,
        b.sibling_no::text || '. ' || b.stat_name AS stat_name_no,
        b.stat_name,
        b.cycle,
        b.srch_yn,
        b.org_name,
        b.vw_cd,
        b.stat_id,
        b.send_de,
        b.level_no,
        b.full_path,
        b.created_at,
        b.sibling_no
    FROM base b
    WHERE b.p_stat_code = '*'

    UNION ALL

    /* 하위 */
    SELECT
        c.p_stat_code,
        c.stat_code,
        t.tree_no || '.' || c.sibling_no::text AS tree_no,
        t.tree_no || '.' || c.sibling_no::text || '. ' || c.stat_name AS stat_name_no,
        c.stat_name,
        c.cycle,
        c.srch_yn,
        c.org_name,
        c.vw_cd,
        c.stat_id,
        c.send_de,
        c.level_no,
        c.full_path,
        c.created_at,
        c.sibling_no
    FROM base c
    JOIN tree t
      ON c.p_stat_code = t.stat_code
)
INSERT INTO dp.api_stat_list_kosis (
   p_stat_code,
   stat_code,
   tree_no,
   stat_name_no,
   stat_name,
   cycle,
   srch_yn,
   org_name,
   vw_cd,
   stat_id,
   send_de,
   level_no,
   full_path,
   created_at
)
SELECT
    p_stat_code,
    stat_code,
    tree_no,
    stat_name_no,
    stat_name,
    cycle,
    srch_yn,
    org_name,
    vw_cd,
    stat_id,
    send_de,
    level_no,
    full_path,
    created_at
FROM tree
ORDER BY tree_no;